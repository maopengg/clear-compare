{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clear Compare",
  "version": "0.1.0",
  "identifier": "io.github.maopengg.clearcompare",
  "build": {
    "beforeDevCommand": "trunk --no-color serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk --no-color build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clear Compare",
        "width": 1260,
        "height": 840,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost tauri://localhost http://tauri.localhost https://tauri.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "File comparison and verified folder synchronization",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 Clear Compare contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
