{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window with explicit comparison commands; no generic filesystem or shell access",
  "windows": ["main"],
  "permissions": [
    "core:default", "allow-compare", "allow-cancel", "allow-page", "allow-text-diff",
    "allow-preview-sync", "allow-apply-sync", "allow-pick-directory", "allow-load-session", "allow-save-session"
  ]
}
