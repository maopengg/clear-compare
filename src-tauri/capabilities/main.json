{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window with explicit comparison commands; no generic filesystem or shell access",
  "windows": ["main"],
  "permissions": [
    "core:default", "allow-compare", "allow-cancel", "allow-page", "allow-query-folder", "allow-picture-preview", "allow-text-diff", "allow-merge-buffers", "allow-binary-page", "allow-table-compare", "allow-table-page",
    "allow-preview-sync", "allow-apply-sync", "allow-pick-directory", "allow-load-session", "allow-save-session", "allow-list-sessions", "allow-load-library-session", "allow-save-library-session", "allow-archive-session",
    "allow-open-document", "allow-close-document", "allow-save-document", "allow-preview-editor-restore", "allow-apply-editor-restore", "allow-list-sync-history", "allow-preview-sync-recovery", "allow-apply-sync-recovery"
  ]
}
